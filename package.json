{
  "name": "xinbao-qiao-academic-wiki",
  "version": "0.3.0",
  "private": true,
  "description": "Personal academic wiki homepage for Xinbao Qiao.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "next build",
    "lint:wiki": "node scripts/lint-wikilinks.mjs",
    "test:wiki": "node scripts/test-wiki-data.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint:wiki && npm run test:wiki",
    "cf:dev": "npm exec --package=wrangler -- wrangler dev --config cloudflare/wrangler.toml",
    "cf:deploy": "npm exec --package=wrangler -- wrangler deploy --config cloudflare/wrangler.toml"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.45",
    "next": "15",
    "react": "19",
    "react-dom": "19",
    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
