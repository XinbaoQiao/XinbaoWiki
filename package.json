{
  "name": "xinbaopedia",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A bilingual, searchable academic wiki with citation-grounded LLM answers and agent-readable knowledge exports.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "setup:node22": "node scripts/bootstrap-node22.mjs",
    "dev": "node scripts/run-with-node22.mjs next dev",
    "start": "node scripts/run-with-node22.mjs next start",
    "build": "node scripts/run-with-node22.mjs next build",
    "export": "npm run build",
    "lint:wiki": "node scripts/lint-wikilinks.mjs",
    "lint:okf": "node scripts/okf-conformance.mjs",
    "lint:content": "node scripts/wiki-maintenance.mjs --check",
    "audit:wiki": "node scripts/run-with-node22.mjs node scripts/audit-wiki-maintenance.mjs",
    "eval:wiki-chat": "node scripts/run-with-node22.mjs node scripts/evaluate-wiki-chat.mjs",
    "generate:site-activity-map": "node scripts/run-with-node22.mjs node scripts/generate-site-activity-map.mjs",
    "maintain:wiki": "node scripts/run-with-node22.mjs node scripts/wiki-maintenance.mjs --standardize --write",
    "new:wiki": "node scripts/new-wiki-page.mjs",
    "test:release": "node scripts/run-with-node22.mjs node scripts/test-release-workflow.mjs",
    "test:cube-geometry": "node scripts/run-with-node22.mjs playwright test tests/browser/cube-geometry.spec.mjs",
    "test:site-activity": "node scripts/run-with-node22.mjs playwright test tests/browser/site-activity.spec.mjs",
    "test:wiki": "node scripts/run-with-node22.mjs node scripts/test-wiki-data.mjs",
    "verify:publish": "node scripts/run-with-node22.mjs node scripts/verify-publish-set.mjs",
    "verify:staged": "node scripts/run-with-node22.mjs node scripts/verify-publish-set.mjs --staged-only",
    "push:check": "node scripts/run-with-node22.mjs node scripts/push-main.mjs --check",
    "push:main": "node scripts/run-with-node22.mjs node scripts/push-main.mjs",
    "smoke:production": "node scripts/run-with-node22.mjs node scripts/smoke-production.mjs",
    "deploy:production": "node scripts/run-with-node22.mjs node scripts/deploy-production.mjs",
    "release:production": "node scripts/run-with-node22.mjs node scripts/release-production.mjs",
    "release:resume": "node scripts/run-with-node22.mjs node scripts/release-production.mjs --resume",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "typecheck": "node scripts/prepare-typecheck.mjs && tsc --noEmit",
    "check": "node scripts/run-with-node22.mjs npm run check:node22",
    "check:node22": "npm run typecheck && npm run lint:wiki && npm run lint:content && npm run lint:okf && npm run test:features && npm run test:wiki && npm run audit:wiki && npm run eval:wiki-chat && npm run test:release",
    "test:features": "node scripts/test-content-manifest.mjs && node scripts/test-chat-hardening.mjs && node scripts/test-site-activity.mjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.45",
    "next": "15.5.20",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "js-yaml": "3.15.0",
    "postcss": "^8.5.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XinbaoQiao/XinbaoWiki.git"
  },
  "homepage": "https://xinbaopedia.top",
  "bugs": {
    "url": "https://github.com/XinbaoQiao/XinbaoWiki/issues"
  },
  "keywords": [
    "academic-wiki",
    "bilingual",
    "knowledge-graph",
    "llm",
    "nextjs",
    "rag",
    "typescript"
  ]
}
