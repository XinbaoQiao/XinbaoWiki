{
  "schemaVersion": 1,
  "name": "Xinbaopedia bilingual retrieval and grounding gate",
  "description": "Offline golden questions for the production wiki retriever. The set tests public biographical facts, research, publications, citations, multi-page synthesis, and evidence-based abstention without calling a model provider.",
  "topK": 8,
  "thresholds": {
    "retrievalRecallAtK": 0.9,
    "fullCaseRecallAtK": 0.85,
    "evidencePatternRecall": 0.9,
    "citationValidity": 1,
    "answerabilityAccuracy": 1,
    "abstentionAccuracy": 1,
    "indexCoverage": 0.98,
    "publicIndexPurity": 1,
    "languagePurity": 1
  },
  "cases": [
    {
      "id": "en-profile-affiliation",
      "language": "en",
      "category": "profile",
      "query": "Who is Xinbao Qiao and where is he currently studying?",
      "expectedSlugs": ["Xinbao_Qiao"],
      "evidencePatterns": ["PhD student", "Chinese University of Hong Kong"]
    },
    {
      "id": "en-profile-education",
      "language": "en",
      "category": "multi-hop",
      "query": "Where did Xinbao Qiao complete his bachelor's and master's degrees?",
      "expectedSlugs": ["Shandong_University", "Zhejiang_University"],
      "evidencePatterns": ["Shandong University", "Zhejiang University"]
    },
    {
      "id": "en-research-lifecycle",
      "language": "en",
      "category": "research",
      "query": "How does Xinbao Qiao organize his research around the lifecycle of data?",
      "expectedSlugs": ["Xinbao_Qiao", "Data_Centric_Machine_Learning"],
      "evidencePatterns": ["data generation", "data deletion"]
    },
    {
      "id": "en-research-ai-networks",
      "language": "en",
      "category": "research",
      "query": "What does AI and networks mean in Xinbao Qiao's research?",
      "expectedSlugs": ["AI_and_Networks"],
      "evidencePatterns": ["AI for Networks", "Networks for AI"]
    },
    {
      "id": "en-publication-dynfrs",
      "language": "en",
      "category": "publication",
      "query": "Which Xinbao Qiao paper studies efficient machine unlearning for random forests?",
      "expectedSlugs": ["DynFrs"],
      "evidencePatterns": ["random forest", "ICLR 2025"]
    },
    {
      "id": "en-publication-soft-weighted",
      "language": "en",
      "category": "publication",
      "query": "Which paper uses soft-weighted unlearning for fairness and robustness correction?",
      "expectedSlugs": ["Soft_Weighted_Machine_Unlearning"],
      "evidencePatterns": ["fairness", "robustness"]
    },
    {
      "id": "en-model-collapse-multihop",
      "language": "en",
      "category": "multi-hop",
      "query": "How are sample-selection bias and Wasserstein geometry connected in the model-collapse work?",
      "expectedSlugs": [
        "When_Sample_Selection_Bias_Precipitates_Model_Collapse",
        "Wasserstein_Geometry"
      ],
      "evidencePatterns": ["sample selection bias", "Wasserstein"]
    },
    {
      "id": "en-citation-public-profile",
      "language": "en",
      "category": "citation",
      "query": "Which wiki page provides Xinbao Qiao's public academic profile and external profile links?",
      "expectedSlugs": ["Xinbao_Qiao"],
      "evidencePatterns": ["OpenReview", "ORCID"]
    },
    {
      "id": "en-abstain-unsupported-private",
      "language": "en",
      "category": "abstention",
      "query": "What is Xinbao Qiao's passport number?",
      "expectedAbstain": true,
      "abstentionMode": "no-evidence",
      "unsupportedEvidencePatterns": ["passport number", "passport no"]
    },
    {
      "id": "en-abstain-out-of-domain",
      "language": "en",
      "category": "abstention",
      "query": "How should I bake a sourdough loaf?",
      "expectedAbstain": true,
      "abstentionMode": "no-retrieval"
    },
    {
      "id": "en-abstain-history-isolation",
      "language": "en",
      "category": "abstention",
      "query": "How should I bake a sourdough loaf?",
      "priorUserMessages": ["What is Xinbao Qiao's research?"],
      "expectedAbstain": true,
      "abstentionMode": "no-retrieval"
    },
    {
      "id": "en-abstain-mixed-out-of-domain",
