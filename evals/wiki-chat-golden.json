{
  "schemaVersion": 1,
  "name": "Xinbaopedia bilingual retrieval and grounding gate",
  "description": "Offline golden questions for the production wiki retriever. Retrieval abstention is a routing signal for normal conversation unless a protected blockedReason is present. The set tests public facts, natural homepage phrasing, page references, multi-page synthesis, and protected boundaries without calling a model provider.",
  "topK": 8,
  "thresholds": {
    "retrievalRecallAtK": 0.9,
    "fullCaseRecallAtK": 0.85,
    "evidencePatternRecall": 0.9,
    "citationValidity": 1,
    "answerabilityAccuracy": 1,
    "abstentionAccuracy": 1,
    "indexCoverage": 0.98,
    "publicIndexPurity": 1,
    "languagePurity": 1
  },
  "cases": [
    {
      "id": "en-profile-affiliation",
      "language": "en",
      "category": "profile",
      "query": "Who is Xinbao Qiao and where is he currently studying?",
      "expectedSlugs": ["Xinbao_Qiao"],
      "evidencePatterns": ["PhD student", "Chinese University of Hong Kong"]
    },
    {
